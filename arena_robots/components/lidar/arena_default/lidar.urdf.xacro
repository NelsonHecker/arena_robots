<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Mount-aware wrapper around arena_default_lidar (config/urdf/sensors/default.xacro):
       that macro takes a scalar z_offset, not an *origin block, so it can't be invoked
       through the assembly-catalog wrapper contract (catalog.render_wrapper_xacro always
       appends an <origin> child to every placement). Body copied verbatim from
       arena_default_lidar; config/urdf/sensors/default.xacro stays untouched since
       husky/dingo/WLP311D/WLP311E/ridgeback_plus/boxer still call it directly. -->
  <xacro:arg name="sim_path" default=""/>

  <xacro:macro name="arena_default_lidar_mount" params="parent_link *origin frame:=lidar
                                                         update_rate:=10 samples:=720
                                                         min_angle:=-3.14159 max_angle:=3.14159
                                                         min_range:=0.1 max_range:=30.0">
    <link name="${frame}"/>

    <joint name="${frame}_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent_link}"/>
      <child link="${frame}"/>
    </joint>

    <gazebo reference="${frame}">
      <sensor name="gpu_lidar" type="gpu_lidar">
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <gz_frame_id>$(arg sim_path)/${frame}</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>${min_angle}</min_angle>
              <max_angle>${max_angle}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
