<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Jackal's own bespoke IMU, including the explicit per-sensor imu-system
       plugin and the absolute "/imu/data" topic (both upstream jackal_description
       quirks, kept as-is; the arena_default imu component has neither). joint_name is
       separate from frame like lidar/jackal_default: jackal's joint is named "imu_joint", not
       "${frame}_joint". -->
  <xacro:arg name="sim_path" default=""/>

  <xacro:macro name="jackal_imu_mount" params="parent_link *origin frame:=imu_link joint_name:=imu_joint">
    <link name="${frame}">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-09" ixy="0.0" ixz="0.0" iyy="1e-09" iyz="0.0" izz="1e-09"/>
      </inertial>
    </link>

    <joint name="${joint_name}" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent_link}"/>
      <child link="${frame}"/>
    </joint>

    <gazebo reference="${frame}">
      <sensor name="imu_sensor" type="imu">
        <plugin filename="libgz-sim-imu-system" name="gz::sim::systems::Imu">
          <topic>/imu/data</topic>
          <frame_id>$(arg sim_path)/${frame}</frame_id>
        </plugin>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
        <enable_metrics>true</enable_metrics>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>
</robot>
