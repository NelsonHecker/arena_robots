<?xml version="1.0"?>
<!-- ur10e component SRDF fragment (phase3 sec2.10): group/group_states/mount-adjacency
     disable_collisions/intra-arm disable_collisions, extracted byte-identical (link/joint
     names aside) from robots/{rbvogui,rbkairos,rbrobout}_plus/srdf/*.srdf.xacro (verified:
     only the chassis-residual fragment differs per robot; that lives in the chassis's own
     srdf/<robot>.srdf.xacro, composed alongside this fragment by moveit_factory.py). Content
     is identical to the ur5e fragment: group_state joint values are generic UR presets, not
     ur_type-dependent. Proper xacro: prefix/mount/parent are declared args, resolved per
     placement from caps.moveit.args (phase3 items 6/7, SRDF composition parity). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur10e_arm_fragment">
  <xacro:arg name="prefix" default="robot_"/>
  <xacro:arg name="mount" default="arm0"/>
  <xacro:arg name="parent" default="chassis_link"/>

  <group name="$(arg mount)_manipulator">
    <chain base_link="$(arg prefix)$(arg mount)_base_link" tip_link="$(arg prefix)$(arg mount)_tool0"/>
  </group>

  <group_state name="home" group="$(arg mount)_manipulator">
    <joint name="$(arg prefix)$(arg mount)_shoulder_pan_joint" value="0.0"/>
    <joint name="$(arg prefix)$(arg mount)_shoulder_lift_joint" value="-1.5707"/>
    <joint name="$(arg prefix)$(arg mount)_elbow_joint" value="1.5707"/>
    <joint name="$(arg prefix)$(arg mount)_wrist_1_joint" value="-1.5707"/>
    <joint name="$(arg prefix)$(arg mount)_wrist_2_joint" value="-1.5707"/>
    <joint name="$(arg prefix)$(arg mount)_wrist_3_joint" value="0.0"/>
  </group_state>

  <group_state name="up" group="$(arg mount)_manipulator">
    <joint name="$(arg prefix)$(arg mount)_shoulder_pan_joint" value="0.0"/>
    <joint name="$(arg prefix)$(arg mount)_shoulder_lift_joint" value="-1.5707"/>
    <joint name="$(arg prefix)$(arg mount)_elbow_joint" value="0.0"/>
    <joint name="$(arg prefix)$(arg mount)_wrist_1_joint" value="-1.5707"/>
    <joint name="$(arg prefix)$(arg mount)_wrist_2_joint" value="0.0"/>
    <joint name="$(arg prefix)$(arg mount)_wrist_3_joint" value="0.0"/>
  </group_state>

  <disable_collisions link1="$(arg prefix)$(arg parent)" link2="$(arg prefix)$(arg mount)_base_link" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg parent)" link2="$(arg prefix)$(arg mount)_base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_base_link" link2="$(arg prefix)$(arg mount)_base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_base_link" link2="$(arg prefix)$(arg mount)_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_base_link_inertia" link2="$(arg prefix)$(arg mount)_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_shoulder_link" link2="$(arg prefix)$(arg mount)_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_upper_arm_link" link2="$(arg prefix)$(arg mount)_forearm_link" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_forearm_link" link2="$(arg prefix)$(arg mount)_wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_wrist_1_link" link2="$(arg prefix)$(arg mount)_wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_wrist_2_link" link2="$(arg prefix)$(arg mount)_wrist_3_link" reason="Adjacent"/>

</robot>
