<robot name="rbrobout" xmlns:gz="http://gazebosim.org/schema">
  <!-- ***************** -->
  <!-- Imported elements -->
  <!-- ***************** -->
  <!-- Import all posible elements defined in the urdf.xacro files. All these elements are defined as macro:xacros -->
  <!-- ***************** -->
