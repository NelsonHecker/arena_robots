  <!--
    Mounting point for accessories on the front bumper.
    Use with caution, but thin sensors (e.g Raspberry Pi NoIR camera) could
    be mounted here for low-budget, front-facing capabilities
  -->
  <link name="front_bumper_mount"/>
  <joint name="front_bumper_mount_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.274 0 0.0345125"/>
    <parent link="chassis_link"/>
    <child link="front_bumper_mount"/>
  </joint>
  <link name="lidar"/>
  <joint name="lidar_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.3"/>
    <parent link="base_link"/>
    <child link="lidar"/>
  </joint>
  <gazebo reference="lidar">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <gz_frame_id>/lidar</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <link name="imu_sensor_link"/>
  <joint name="imu_sensor_link_joint" type="fixed">
