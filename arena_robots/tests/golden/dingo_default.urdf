  </joint>
  <gazebo reference="imu_sensor_link">
    <sensor name="imu_sensor" type="imu">
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>/imu_sensor_link</gz_frame_id>
    </sensor>
  </gazebo>
