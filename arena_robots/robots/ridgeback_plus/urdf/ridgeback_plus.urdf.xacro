<?xml version="1.0"?>
<robot name="ridgeback_plus" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:arg name="ur_type" default="ur5e"/>

  <!-- R100 base platform. use_platform_controllers=false skips upstream's
       ros2_control block which uses an unavailable plugin on Jazzy/Harmonic;
       we provide our own block via base_hw/ridgeback_plus.ros2_control.urdf.
       is_sim stays false so r100's generic gazebo.urdf.xacro (with mismatched
       PosePublisher + legacy ign_ros2_control plugin) is skipped too. -->
  <xacro:arg name="use_platform_controllers" default="false"/>
  <xacro:include filename="$(find clearpath_platform_description)/urdf/common.urdf.xacro"/>
  <xacro:include filename="$(find clearpath_platform_description)/urdf/r100/r100.urdf.xacro"/>
  <xacro:r100/>

  <!-- UR arm mounted on chassis_link (top deck at z=0.280 per r100 deck_height) -->
  <!-- TODO: verify arm mount pose against physical hardware -->
  <xacro:include filename="$(find clearpath_manipulators_description)/urdf/arm/universal_robots.urdf.xacro"/>
  <xacro:universal_robots name="arm" parent_link="chassis_link" ur_type="$(arg ur_type)">
    <origin xyz="0 0 0.280" rpy="0 0 0"/>
  </xacro:universal_robots>

  <!-- ros2_control system definition (wheels + arm joints) -->
  <xacro:include filename="$(find arena_robots)/robots/ridgeback_plus/urdf/base_hw/ridgeback_plus.ros2_control.urdf"/>

  <!-- gz_ros2_control plugin (loads control.yaml; namespace + path set via xacro args) -->
  <xacro:include filename="$(find arena_robots)/robots/ridgeback_plus/urdf/ridgeback_plus.gazebo"/>

  <!-- r100 already provides imu_0_link, only the lidar half is needed -->
  <xacro:include filename="$(find arena_robots)/config/urdf/sensors/default.xacro"/>
  <xacro:arena_default_nav_sensors parent_link="base_link" with_imu="false"/>

</robot>
