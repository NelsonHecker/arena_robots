<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ridgeback_plus">

  <group name="ur_manipulator">
    <chain base_link="arm_base_link" tip_link="arm_tool0"/>
  </group>

  <group_state name="home" group="ur_manipulator">
    <joint name="arm_shoulder_pan_joint" value="0.0"/>
    <joint name="arm_shoulder_lift_joint" value="-1.5707"/>
    <joint name="arm_elbow_joint" value="1.5707"/>
    <joint name="arm_wrist_1_joint" value="-1.5707"/>
    <joint name="arm_wrist_2_joint" value="-1.5707"/>
    <joint name="arm_wrist_3_joint" value="0.0"/>
  </group_state>

  <group_state name="up" group="ur_manipulator">
    <joint name="arm_shoulder_pan_joint" value="0.0"/>
    <joint name="arm_shoulder_lift_joint" value="-1.5707"/>
    <joint name="arm_elbow_joint" value="0.0"/>
    <joint name="arm_wrist_1_joint" value="-1.5707"/>
    <joint name="arm_wrist_2_joint" value="0.0"/>
    <joint name="arm_wrist_3_joint" value="0.0"/>
  </group_state>

  <disable_collisions link1="chassis_link" link2="arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="chassis_link" link2="arm_base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link" link2="arm_base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link" link2="arm_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link_inertia" link2="arm_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="arm_shoulder_link" link2="arm_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_upper_arm_link" link2="arm_forearm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_forearm_link" link2="arm_wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="arm_wrist_1_link" link2="arm_wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="arm_wrist_2_link" link2="arm_wrist_3_link" reason="Adjacent"/>

  <!-- r100 deck stack: chassis -> riser -> top, arm mounted on chassis at deck height -->
  <disable_collisions link1="chassis_link" link2="riser_link" reason="Adjacent"/>
  <disable_collisions link1="chassis_link" link2="top_link" reason="Default"/>
  <disable_collisions link1="riser_link" link2="top_link" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link" link2="riser_link" reason="Default"/>
  <disable_collisions link1="arm_base_link" link2="top_link" reason="Default"/>
  <disable_collisions link1="arm_base_link_inertia" link2="riser_link" reason="Default"/>
  <disable_collisions link1="arm_base_link_inertia" link2="top_link" reason="Default"/>
  <disable_collisions link1="arm_shoulder_link" link2="riser_link" reason="Default"/>
  <disable_collisions link1="arm_shoulder_link" link2="top_link" reason="Default"/>
  <disable_collisions link1="arm_upper_arm_link" link2="top_link" reason="Default"/>
  <disable_collisions link1="arm_forearm_link" link2="top_link" reason="Default"/>

  <!-- wheels permanently in contact with the chassis collision box -->
  <disable_collisions link1="chassis_link" link2="front_left_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="chassis_link" link2="front_right_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="chassis_link" link2="rear_left_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="chassis_link" link2="rear_right_wheel_link" reason="Adjacent"/>

</robot>
