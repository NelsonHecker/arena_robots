<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rbvogui_plus">

  <group name="ur_manipulator">
    <chain base_link="robot_arm_base_link" tip_link="robot_arm_tool0"/>
  </group>

  <group_state name="home" group="ur_manipulator">
    <joint name="robot_arm_shoulder_pan_joint" value="0.0"/>
    <joint name="robot_arm_shoulder_lift_joint" value="-1.5707"/>
    <joint name="robot_arm_elbow_joint" value="1.5707"/>
    <joint name="robot_arm_wrist_1_joint" value="-1.5707"/>
    <joint name="robot_arm_wrist_2_joint" value="-1.5707"/>
    <joint name="robot_arm_wrist_3_joint" value="0.0"/>
  </group_state>

  <group_state name="up" group="ur_manipulator">
    <joint name="robot_arm_shoulder_pan_joint" value="0.0"/>
    <joint name="robot_arm_shoulder_lift_joint" value="-1.5707"/>
    <joint name="robot_arm_elbow_joint" value="0.0"/>
    <joint name="robot_arm_wrist_1_joint" value="-1.5707"/>
    <joint name="robot_arm_wrist_2_joint" value="0.0"/>
    <joint name="robot_arm_wrist_3_joint" value="0.0"/>
  </group_state>

  <disable_collisions link1="robot_chassis_link" link2="robot_arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="robot_chassis_link" link2="robot_arm_base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="robot_arm_base_link" link2="robot_arm_base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="robot_arm_base_link" link2="robot_arm_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="robot_arm_base_link_inertia" link2="robot_arm_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="robot_arm_shoulder_link" link2="robot_arm_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="robot_arm_upper_arm_link" link2="robot_arm_forearm_link" reason="Adjacent"/>
  <disable_collisions link1="robot_arm_forearm_link" link2="robot_arm_wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="robot_arm_wrist_1_link" link2="robot_arm_wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="robot_arm_wrist_2_link" link2="robot_arm_wrist_3_link" reason="Adjacent"/>

  <!-- chassis stack (all fixed-jointed off chassis_link) -->
  <disable_collisions link1="robot_base_link" link2="robot_chassis_link" reason="Adjacent"/>
  <disable_collisions link1="robot_chassis_link" link2="robot_battery_link" reason="Adjacent"/>
  <disable_collisions link1="robot_chassis_link" link2="robot_contactors_link" reason="Adjacent"/>
  <disable_collisions link1="robot_chassis_link" link2="robot_base_logos_link" reason="Adjacent"/>
  <disable_collisions link1="robot_chassis_link" link2="robot_leds_link" reason="Adjacent"/>

  <!-- 4WIS swerve corners: base_link -> steering_joint -> base_wheel -> rubber wheel -->
  <disable_collisions link1="robot_base_link" link2="robot_front_right_base_wheel" reason="Adjacent"/>
  <disable_collisions link1="robot_front_right_base_wheel" link2="robot_front_right_wheel" reason="Adjacent"/>
  <disable_collisions link1="robot_base_link" link2="robot_front_left_base_wheel" reason="Adjacent"/>
  <disable_collisions link1="robot_front_left_base_wheel" link2="robot_front_left_wheel" reason="Adjacent"/>
  <disable_collisions link1="robot_base_link" link2="robot_back_left_base_wheel" reason="Adjacent"/>
  <disable_collisions link1="robot_back_left_base_wheel" link2="robot_back_left_wheel" reason="Adjacent"/>
  <disable_collisions link1="robot_base_link" link2="robot_back_right_base_wheel" reason="Adjacent"/>
  <disable_collisions link1="robot_back_right_base_wheel" link2="robot_back_right_wheel" reason="Adjacent"/>

</robot>
