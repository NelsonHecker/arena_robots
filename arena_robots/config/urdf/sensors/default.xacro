<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="sim_path" default=""/>

  <xacro:macro name="arena_default_lidar" params="parent_link frame:=lidar
                                                  z_offset:=0.3 update_rate:=10
                                                  samples:=720 min_angle:=-3.14159 max_angle:=3.14159
                                                  min_range:=0.1 max_range:=30.0">
    <link name="${frame}"/>

    <joint name="${frame}_joint" type="fixed">
      <origin xyz="0 0 ${z_offset}" rpy="0 0 0"/>
      <parent link="${parent_link}"/>
      <child link="${frame}"/>
    </joint>

    <gazebo reference="${frame}">
      <sensor name="gpu_lidar" type="gpu_lidar">
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <gz_frame_id>$(arg sim_path)/${frame}</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>${min_angle}</min_angle>
              <max_angle>${max_angle}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="arena_default_imu" params="parent_link frame:=imu_link
                                                update_rate:=100">
    <link name="${frame}"/>

    <joint name="${frame}_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent_link}"/>
      <child link="${frame}"/>
    </joint>

    <gazebo reference="${frame}">
      <sensor name="imu_sensor" type="imu">
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <gz_frame_id>$(arg sim_path)/${frame}</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="arena_default_nav_sensors" params="parent_link
                                                       with_lidar:=true with_imu:=true">
    <xacro:if value="${with_lidar}">
      <xacro:arena_default_lidar parent_link="${parent_link}"/>
    </xacro:if>
    <xacro:if value="${with_imu}">
      <xacro:arena_default_imu parent_link="${parent_link}"/>
    </xacro:if>
  </xacro:macro>

</robot>
